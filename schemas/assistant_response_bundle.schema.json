{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://legalize-mx.local/schemas/assistant_response_bundle.schema.json",
  "title": "AssistantResponseBundle",
  "type": "object",
  "required": [
    "response_text",
    "citations",
    "claims"
  ],
  "properties": {
    "request_id": { "type": ["string", "null"] },
    "response_type": { "type": ["string", "null"] },
    "jurisdiction": { "type": ["string", "null"] },
    "query_date": { "type": ["string", "null"] },
    "response_text": { "type": "string" },
    "citations": {
      "type": "array",
      "items": { "$ref": "citation.schema.json" }
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "claim_id",
          "text",
          "kind",
          "citation_ids"
        ],
        "properties": {
          "claim_id": { "type": "string" },
          "text": { "type": "string" },
          "kind": { "type": "string" },
          "citation_ids": {
            "type": "array",
            "items": { "type": "string" }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
