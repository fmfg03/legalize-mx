{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://legalize-mx.local/schemas/citation.schema.json",
  "title": "Citation",
  "type": "object",
  "required": [
    "citation_id",
    "doc_type",
    "doc_id",
    "title",
    "locator",
    "jurisdiction",
    "source_url"
  ],
  "properties": {
    "citation_id": { "type": "string" },
    "doc_type": { "type": "string" },
    "doc_id": { "type": "string" },
    "title": { "type": "string" },
    "locator": { "type": "string" },
    "jurisdiction": { "type": "string" },
    "status": { "type": ["string", "null"] },
    "effective_at_query_date": { "type": ["boolean", "null"] },
    "source_url": { "type": "string" },
    "official_publication": { "type": ["string", "null"] },
    "official_publication_date": { "type": ["string", "null"] },
    "quote": { "type": ["string", "null"] },
    "quote_sha256": { "type": ["string", "null"] }
  },
  "additionalProperties": true
}
